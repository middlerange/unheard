{
  "name": "content-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env.local node_modules/vite/bin/vite.js dev",
    "build": "node scripts/prepare-skill.mjs && vite build && node scripts/patch-worker.mjs",
    "start": "node dist/server/server.mjs",
    "migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:playwright": "playwright test",
    "test:e2e:local": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "seed:test": "tsx lib/db/seed.ts",
    "test:all": "npm run test && npm run test:e2e",
    "deploy": "node scripts/prepare-deploy.mjs && wrangler d1 migrations apply DB --remote --config .wrangler.deploy.toml && wrangler deploy --keep-vars --config .wrangler.deploy.toml",
    "ship": "git add -A && git commit -m \"${npm_config_m:-deploy}\" && git push && npm run deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "tsx scripts/seed-local-demo-user.ts",
    "typecheck": "tsc --project tsconfig.app.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.992.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/ai": "^0.5.1",
    "@tanstack/ai-openai": "^0.5.0",
    "@tanstack/ai-react": "^0.5.4",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "nitro": "^3.0.1-alpha.2",
    "openai": "^6.22.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "twitter-api-v2": "^1.29.0",
    "twitter-text": "^3.1.0",
    "userorbit-js": "^0.0.8",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/twitter-text": "^3.1.10",
    "@types/uuid": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.68.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "msw",
    "sharp",
    "unrs-resolver"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/middlerange/unheard.git"
  },
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Required: generate a unique secret with `openssl rand -hex 32`. Keep it private; it signs login sessions."
      },
      "DB": {
        "description": "Stores accounts, teams, drafts, channels and schedules. Created automatically."
      },
      "MEDIA_BUCKET": {
        "description": "Stores uploaded images and videos. Created automatically; media is served through your Worker."
      },
      "CREDENTIALS_ENCRYPTION_KEY": {
        "description": "Required: generate a separate key with `openssl rand -hex 32`. Encrypts social credentials; back it up and keep it stable."
      }
    }
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
