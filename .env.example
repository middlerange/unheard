# Required. Generate EACH independently: openssl rand -hex 32
SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# Optional: add only providers you want, in Worker Settings > Variables and Secrets.
# Social app redirect URLs are shown at /settings/setup on your deployment.
# OPENAI_API_KEY=
# Research uses this key with gpt-6-luna. Collection itself makes no model calls;
# daily 24-hour ranking/drafts and 30-day scans use cached, bounded model calls.
# GEMINI_API_KEY=
# META_APP_ID=
# META_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:content-hub:1.0 (by /u/YOUR_USERNAME)

# Optional canonical URL for MCP discovery (defaults to request origin).
# CONTENT_HUB_PUBLIC_URL=https://your-worker.workers.dev

# Optional Telegram approval workflow; otherwise enable auto-publish in Notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_APPROVER_USER_ID=
# TELEGRAM_WEBHOOK_SECRET=

# Optional Slack OAuth: configure these in Cloudflare Worker runtime settings.
# Keep client and signing secrets encrypted. No Slack app setup in the product UI.
# Users connect their workspace through Settings > Slack > Connect to Slack.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# OAuth redirect: https://YOUR_ORIGIN/api/slack/oauth/callback
# Use CONTENT_HUB_PUBLIC_URL above when this deployment has multiple hostnames.

# Local development only: D1 HTTP access to YOUR database.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_D1_DATABASE_ID=

# Existing deployments: set these in Cloudflare Builds, not runtime secrets.
# CONTENT_HUB_D1_DATABASE_ID=
# CONTENT_HUB_R2_BUCKET_NAME=

# Optional legacy S3-compatible R2 access. Deployed Workers use MEDIA_BUCKET instead.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
